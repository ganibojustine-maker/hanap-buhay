# Copy to .env (local) and set the same keys in Render. Never commit .env
APP_NAME=HANAPBUHAY
APP_KEY=change-me-long-random
APP_ENV=development

# Aiven MySQL
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=hanapbuhay
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL=true
DB_SSL_CA=certs/aiven-ca.pem
# Keep the database connection open between requests (faster; set false to turn off)
DB_PERSISTENT=true

# API / JWT (two different long random strings)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Google Sign-In (client ID only; no secret needed)
GOOGLE_CLIENT_ID=202897350032-iomn9ihif7p5g74gsvqfj6j8c64i71bq.apps.googleusercontent.com

# Brevo (Sendinblue) Transactional Email API — used for ALL email notifications
# (hired / interview / application alerts). Get a v3 API key from:
# https://app.brevo.com/settings/keys/api   (NOT the SMTP key)
# MAIL_FROM_ADDRESS must be a sender you verified in Brevo → Senders & IP.
# If BREVO_API_KEY is empty, emails are only written to runtime/logs/mail.log.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=your-verified-sender@gmail.com
MAIL_FROM_NAME="HanapBuhay Oriental Mindoro"

# Firebase Realtime Database: chat messages and Help & Support requests live ONLY in Firebase.
# Console → Project settings → Service accounts → Generate new private key,
# then copy client_email and private_key from the downloaded JSON.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: only if your database isn't the project's default
# (https://<project-id>-default-rtdb.firebaseio.com), e.g. one in another region.
# FIREBASE_DATABASE_URL=

# PayMongo (https://dashboard.paymongo.com → Developers → API keys). This project uses the
# SANDBOX only: use the TEST keys (sk_test_..., pk_test_...). Payments are marked "Test"
# everywhere and no real money moves. A live key (sk_live_...) is ignored on purpose unless
# PAYMONGO_ALLOW_LIVE=true is also set. Screens show payments like a real system (no "Test"
# labels); set PAYMONGO_SHOW_TEST_LABELS=true to show them. The database always records
# which payments were test payments (payments.is_test).
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Payment methods shown at checkout. Only list methods turned on for your PayMongo account.
# Options: card, gcash, paymaya, grab_pay, qrph, dob, dob_ubp, billease, brankas_bdo,
#          brankas_landbank, brankas_metrobank, shopee_pay
PAYMONGO_METHODS=card,gcash,paymaya,grab_pay,qrph
# Webhook signing secret: Developers → Webhooks → create one for
#   https://<your-api>/api/subscriptions/webhook
# with the events checkout_session.payment.paid, payment.paid, payment.failed,
# payment.refunded and payment.refund.updated. PayMongo does not resend events it could not
# deliver, so the cron below (and opening the billing page) also re-checks pending payments.
PAYMONGO_WEBHOOK_SECRET=

# Set a long random secret and have a free pinger (e.g. cron-job.org) open
# https://<your-api>/api/cron/reminders?key=<secret> every 15-30 minutes. It sends interview
# reminders, re-checks pending PayMongo payments, ends plans past their date and sends
# renewal reminders (and keeps the free Render server awake).
CRON_SECRET=

# Docker/Render only: apply pending database migrations each time the container starts
# (backend/docker-start.sh). Set to false to run them by hand instead.
# RUN_MIGRATIONS=true

# Set to true when behind a reverse proxy (Render, Cloudflare) so rate limits
# use the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# Public URL of the React frontend (used for links inside emails)
APP_FRONTEND_URL=http://localhost:5173
