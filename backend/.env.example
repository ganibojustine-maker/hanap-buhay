# Copy to .env (local) and set the same keys in Render. Never commit .env
APP_NAME=HANAPBUHAY
APP_KEY=change-me-long-random
APP_ENV=development

# Aiven MySQL
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=hanapbuhay
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL=true
DB_SSL_CA=certs/aiven-ca.pem

# API / JWT (two different long random strings)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Google Sign-In (client ID only; no secret needed)
GOOGLE_CLIENT_ID=202897350032-iomn9ihif7p5g74gsvqfj6j8c64i71bq.apps.googleusercontent.com
